<style type="text/css">
.xformcontainer.xelem<%=model.class%> .xtabbody { min-width:1080px; }
.xformcontainer.xelem<%=model.class%> .listing {
  border:1px solid #000;
  float:left;
  padding:10px 15px;
  margin:0 10px 10px 0;
  width:500px;
  height:500px;
  overflow:scroll;
}
.xformcontainer.xelem<%=model.class%> .listing li {
  padding-top:4px;
}
.xformcontainer.xelem<%=model.class%> .rslt {
  border:1px solid #000;
  float:left;
  padding:10px 15px;
  margin:0;
  width:500px;
  height:500px;
  overflow:scroll;
}
.xformcontainer.xelem<%=model.class%> .runas {
  clear:both;
  padding-top:10px;
}
.xformcontainer.xelem<%=model.class%> .runas label {
  display:inline-block;
  width:70px;
}
.xformcontainer.xelem<%=model.class%> .restart_link {
  display:block;
  float:right;
}
</style>
<div class="xtabcontrol">
  <a href="#" class="xtab selected">DB Scripts</a>
  <a href="<%=jsh._BASEURL%><%=model.module_namespace%>Dev/DBObjects" class="xtab">DB Objects</a>
  <a href="<%=jsh._BASEURL%><%=model.module_namespace%>Dev/DBUpgrade" class="xtab">Upgrade</a>
  <a href="<%=jsh._BASEURL%><%=model.module_namespace%>Dev/DBDiff" class="xtab">Diff</a>
  <div class="xpanel">
    <div class="xtabbody selected">
      <div class="dbselect">
        Database:
        <select autocomplete="off" class="db"></select>
        <a href="<%=jsh._BASEURL%><%=model.module_namespace%>Admin/Restart" target="_blank" class="restart_link" style="display:none;">Restart</a>
      </div>
      <div class="run" style="display:none;">
        <div style="padding:4px 0 8px 0;">Please click on a script below to run the database operation:</div>
        <div class="listing"></div>
        <pre class="rslt"></pre>
        <div class="runas">
          <b>Run as database user:</b><br/>
          <div class="admin_container"><label>Admin:</label><input type="checkbox" class="admin" /></div>
          <label>User:</label><input autocomplete="off" type="text" class="user" /><br/>
          <label>Password:</label><input autocomplete="new-password" type="password" class="password" />
        </div>
      </div>
    </div>
  </div>
</div>
<script type="text/x-jsharmony-template" class="<%=model.class%>_scripts_listing_template">
<# var hasChildren = false; #>
<# for(var childname in node) { if(!_.isString(node[childname])) { hasChildren = true; break; }}#>
<# if(hasChildren) { #>
  <ul>
    <# for(var childname in node) { #>
      <# if(_.isString(node[childname])) continue;#>
      <li class="node" data-id="<#=(childname=='(All)'?'*':childname)#>">
        <a class="run" href="#"><#=childname#></a><a class="info" href="#"><img src="<%=jsh._PUBLICURL%>images/icon_search.png" width="12" style="padding-left:8px;position:relative;top:2px;" /></a>
        <#-_this.RenderScriptsNode(node[childname])#>
      </li>
    <# } #>
  </ul>
<# } #>
</script>
<script type="text/x-jsharmony-template" class="<%=model.class%>_DB_listing_template">
  <# if(dbs.length > 1) { #>
    <option value="">Please select...</option>
  <# } #>
  <# for(var db of dbs) { #>
    <option value="<#=db#>"><#=db#></option>
  <# } #>
</script>