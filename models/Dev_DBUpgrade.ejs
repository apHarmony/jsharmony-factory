<style type="text/css">
.xformcontainer.xelem<%=model.class%> .xtabbody { min-width:1080px; }
.xformcontainer.xelem<%=model.class%> .listing {
  border:1px solid #000;
  float:left;
  padding:10px 15px;
  margin:0 10px 10px 0;
  width:500px;
  height:500px;
  overflow:scroll;
}
.xformcontainer.xelem<%=model.class%> .listing ul {
  padding-left:18px;
}
.xformcontainer.xelem<%=model.class%> .listing li {
  padding-top:4px;
}
.xformcontainer.xelem<%=model.class%> .listing a.active {
  font-weight:bold;
}
.xformcontainer.xelem<%=model.class%> .rslt_container {
  border:1px solid #000;
  float:left;
  width:532px;
  height:520px;
  display:flex;
  flex-direction:column;
  background-color:#f2f2f2;
}
.xformcontainer.xelem<%=model.class%> .rslt_actions {
  border-bottom:1px solid #000;
}
.xformcontainer.xelem<%=model.class%> .rslt_actions input {
  margin-left: 3px;
  background-color: #33e033;
  border: 1px solid #333;
}
.xformcontainer.xelem<%=model.class%> .rslt {
  flex-grow: 1;
  overflow:scroll;
  padding:10px 15px;
  margin:0;
  background-color:#f2f2f2;
}
.xformcontainer.xelem<%=model.class%> .runas {
  clear:both;
  padding-top:10px;
}
.xformcontainer.xelem<%=model.class%> .runas label {
  display:inline-block;
  width:70px;
}
.xformcontainer.xelem<%=model.class%> .restart_link {
  display:block;
  float:right;
}
</style>
<div class="xtabcontrol">
  <a href="<%=jsh._BASEURL%><%=model.module_namespace%>Dev/DBScripts" class="xtab">DB Scripts</a>
  <a href="<%=jsh._BASEURL%><%=model.module_namespace%>Dev/DBObjects" class="xtab">DB Objects</a>
  <a href="#" class="xtab selected">Upgrade</a>
  <a href="<%=jsh._BASEURL%><%=model.module_namespace%>Dev/DBDiff" class="xtab">Diff</a>
  <div class="xpanel">
    <div class="xtabbody selected">
      <div class="dbselect">
        Database:
        <select autocomplete="off" class="db"></select>
        <a href="<%=jsh._BASEURL%><%=model.module_namespace%>Admin/Restart" target="_blank" class="restart_link" style="display:none;">Restart</a>
      </div>
      <div class="run" style="display:none;">
        <div style="padding:4px 0 8px 0;">Please click on an upgrade script to preview, and then press "Run" to execute.</div>
        <div class="listing"></div>
        <div class="rslt_container">
          <div class="rslt_actions">
            <input type="button" value="Run &#x25B6;" class="rslt_run" />
          </div>
          <pre class="rslt"></pre>
        </div>
        <div class="runas">
          <b>Run as database user:</b><br/>
          <div class="admin_container"><label>Admin:</label><input type="checkbox" class="admin" /></div>
          <label>User:</label><input autocomplete="off" type="text" class="user" /><br/>
          <label>Password:</label><input autocomplete="new-password" type="password" class="password" />
        </div>
      </div>
    </div>
  </div>
</div>
<script type="text/x-jsharmony-template" class="<%=model.class%>_module_listing_template">
  <ul>
    <# for(var moduleName in node) { #>
      <# if(_.isEmpty(node[moduleName])) continue; #>
      <li data-id="<#=moduleName#>" class="node">
        <span><#=moduleName#></span>
        <#-_this.RenderModuleScripts(moduleName, node[moduleName])#>
      </li>
    <# } #>
  </ul>
</script>
<script type="text/x-jsharmony-template" class="<%=model.class%>_module_scripts_listing_template">
  <ul>
    <# for(var scriptName in scripts) { #>
      <li data-id="<#=scriptName#>" class="node">
        <# var isActive = _this.isVersionActive(moduleName, scriptName); #>
        <a href="#" class="upgrade_link <#=isActive?'active':''#>" data-script="<#=scriptName#>" data-module="<#=moduleName#>"><#=scriptName#></a>
      </li>
    <# } #>
  </ul>
</script>
<script type="text/x-jsharmony-template" class="<%=model.class%>_DB_listing_template">
  <# if(dbs.length > 1) { #>
    <option value="">Please select...</option>
  <# } #>
  <# for(var db of dbs) { #>
    <option value="<#=db#>"><#=db#></option>
  <# } #>
</script>